# ========================================================
# FreightAgent Frontend Environment Variables Template
# Copy this file to .env.local for local development
# or set these in GitHub Secrets / AWS Production Server
# ========================================================

# Public API URL (client-side and browser fetch)
NEXT_PUBLIC_API_URL=https://freight-agent-backend.vercel.app/api/v1

# Internal Backend URL for Server-Side calls / Docker network
BACKEND_API_URL=https://freight-agent-backend.vercel.app/api/v1

# Frontend Application Canonical URL
NEXT_PUBLIC_APP_URL=https://freightagent.vercel.app

# Real-time WebSocket Gateway URL
NEXT_PUBLIC_SOCKET_URL=https://freightagent.vercel.app

# Auth Token Keys
NEXT_PUBLIC_ACCESS_TOKEN_KEY=accessToken
NEXT_PUBLIC_REFRESH_TOKEN_KEY=refreshToken
NEXT_PUBLIC_SESSION_TOKEN_KEY=better-auth.session_token

# Third-party Integrations
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
